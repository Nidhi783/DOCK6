    SphereRadius = r,
    Margin = r + 6,
    GridScore = extract_grid_score(scored_file),
    HeavyAtomRMSD = unname(metrics["HeavyAtomRMSD"]),
    CentroidDistance = unname(metrics["CentroidDistance"])
  )
}) |> bind_rows()

