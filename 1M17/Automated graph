find_scored_file <- function(expected_file, exact_name) {

  if (file.exists(expected_file)) {
    return(expected_file)
  }

  hits <- list.files(
    BASE_DIR,
    pattern = paste0("^", gsub("\\.", "\\\\.", exact_name), "$"),
    recursive = TRUE,
    full.names = TRUE
  )

  if (length(hits) == 1) {
    return(hits[1])
  }

  if (length(hits) > 1) {
    warning(
      "Multiple files named ", exact_name,
      " found. Using first match: ", hits[1]
    )
    return(hits[1])
  }

  expected_file
}

extract_grid_score <- function(file) {
  if (!file.exists(file)) {
    warning("Missing scored MOL2: ", file)
    return(NA_real_)
  }

  x <- readLines(file, warn = FALSE)
  score_line <- grep("Grid[_ ]?Score", x, value = TRUE, ignore.case = TRUE)

  if (length(score_line) == 0) {
    warning("Grid Score not found in: ", file)
    return(NA_real_)
  }

  value <- sub(
    ".*?(-?[0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?)\\s*$",
    "\\1",
    score_line[1],
    perl = TRUE
  )

  suppressWarnings(as.numeric(value))
}

read_heavy_atoms <- function(file) {
  if (!file.exists(file)) stop("Missing MOL2 file: ", file)

  x <- readLines(file, warn = FALSE)
  atom_start <- which(trimws(x) == "@<TRIPOS>ATOM")
  if (length(atom_start) == 0) stop("No @<TRIPOS>ATOM section in: ", file)

  start <- atom_start[1] + 1
  next_headers <- which(grepl("^@<TRIPOS>", x) & seq_along(x) > atom_start[1])
  end <- if (length(next_headers) > 0) next_headers[1] - 1 else length(x)

  atom_lines <- x[start:end]
  atom_lines <- atom_lines[nzchar(trimws(atom_lines))]

  parsed <- lapply(atom_lines, function(line) {
    p <- strsplit(trimws(line), "\\s+")[[1]]
    if (length(p) < 6) return(NULL)

    atom_name <- p[2]
    atom_type <- p[6]
    element <- toupper(strsplit(atom_type, "\\.")[[1]][1])
    if (element == "H") return(NULL)

    xyz <- suppressWarnings(as.numeric(p[3:5]))
    if (any(is.na(xyz))) return(NULL)

    data.frame(
      AtomName = atom_name,
      X = xyz[1],
      Y = xyz[2],
      Z = xyz[3],
      stringsAsFactors = FALSE
    )
  })

  parsed <- Filter(Negate(is.null), parsed)
  if (length(parsed) == 0) stop("No heavy atoms read from: ", file)

  bind_rows(parsed)
}

calculate_metrics <- function(reference_file, docked_file) {
  if (!file.exists(docked_file)) {
    warning("Missing docked MOL2: ", docked_file)
    return(c(HeavyAtomRMSD = NA_real_, CentroidDistance = NA_real_))
  }

  ref <- read_heavy_atoms(reference_file)
  dock <- read_heavy_atoms(docked_file)

  matched <- inner_join(ref, dock, by = "AtomName", suffix = c("_ref", "_dock"))

  if (nrow(matched) == 0) {
    warning("No common heavy-atom names between reference and: ", docked_file)
    return(c(HeavyAtomRMSD = NA_real_, CentroidDistance = NA_real_))
  }

  diff_sq <- (matched$X_ref - matched$X_dock)^2 +
             (matched$Y_ref - matched$Y_dock)^2 +
             (matched$Z_ref - matched$Z_dock)^2

  rmsd <- sqrt(mean(diff_sq))

  ref_centroid <- c(mean(matched$X_ref), mean(matched$Y_ref), mean(matched$Z_ref))
  dock_centroid <- c(mean(matched$X_dock), mean(matched$Y_dock), mean(matched$Z_dock))
  centroid_distance <- sqrt(sum((ref_centroid - dock_centroid)^2))

  c(HeavyAtomRMSD = rmsd, CentroidDistance = centroid_distance)
}

