# Locate the prepared AQ4 reference automatically.
# Multiple copies may exist in the 1M17 folder. If they are identical,
# the script safely uses the first copy. If they differ, it stops and
# asks you to inspect them rather than choosing arbitrarily.

aq4_candidates <- list.files(
  BASE_DIR,
  pattern = "^AQ4_prepared\\.mol2$",
  recursive = TRUE,
  full.names = TRUE
)

if (length(aq4_candidates) == 0) {
  stop("No AQ4_prepared.mol2 file was found anywhere under: ", BASE_DIR)
}

if (length(aq4_candidates) == 1) {
  AQ4_REFERENCE <- aq4_candidates[1]
} else {

  aq4_md5 <- tools::md5sum(aq4_candidates)

  if (length(unique(unname(aq4_md5))) == 1) {
    AQ4_REFERENCE <- aq4_candidates[1]
    message(
      "Multiple identical AQ4_prepared.mol2 files found. Using: ",
      AQ4_REFERENCE
    )
  } else {

    preferred <- aq4_candidates[
      grepl(
        "positiv.*control.*sphere|positive.*control.*sphere",
        aq4_candidates,
        ignore.case = TRUE
      )
    ]

    if (length(preferred) == 1) {
      AQ4_REFERENCE <- preferred[1]
      warning(
        "AQ4_prepared.mol2 copies are not all identical. ",
        "Using the positive-control copy: ",
        AQ4_REFERENCE
      )
    } else {
      stop(
        "Multiple non-identical AQ4_prepared.mol2 files were found.\n",
        paste(aq4_candidates, collapse = "\n")
      )
    }
  }
}

