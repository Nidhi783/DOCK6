# ============================================================
# CONTROL-SPECIFIC SCORED-FILE FINDERS
# ============================================================

find_positive_scored_file <- function(r) {

  exact_name <- paste0(
    "AQ4_docked_radius", r, "_scored.mol2"
  )

  expected_file <- file.path(
    POS_DIR,
    paste0("radius", r, "_full"),
    exact_name
  )

  if (file.exists(expected_file)) {
    return(expected_file)
  }

  hits <- list.files(
    POS_DIR,
    pattern = paste0("^", gsub("\\.", "\\\\.", exact_name), "$"),
    recursive = TRUE,
    full.names = TRUE
  )

  if (length(hits) == 1) {
    return(hits[1])
  }

  if (length(hits) > 1) {
    stop(
      "Multiple positive-control scored files found for radius ", r, ":\n",
      paste(hits, collapse = "\n")
    )
  }

  warning("Positive scored MOL2 not found for radius ", r)
  expected_file
}

find_negative_scored_file <- function(r) {

  exact_name <- paste0(
    "AQ4_negative_docked_radius", r, "_scored.mol2"
  )

  hits <- list.files(
    NEG_SEARCH_ROOT,
    pattern = paste0("^", gsub("\\.", "\\\\.", exact_name), "$"),
    recursive = TRUE,
    full.names = TRUE
  )

  negative_hits <- hits[
    grepl("negative", hits, ignore.case = TRUE)
  ]

  if (length(negative_hits) == 1) {
    return(negative_hits[1])
  }

  if (length(negative_hits) > 1) {
    stop(
      "Multiple negative-control scored files found for radius ", r, ":\n",
      paste(negative_hits, collapse = "\n")
    )
  }

  if (length(hits) == 1) {
    return(hits[1])
  }

  if (length(hits) > 1) {
    stop(
      "Multiple possible negative-control scored files found for radius ", r, ":\n",
      paste(hits, collapse = "\n")
    )
  }

  warning("Negative scored MOL2 not found for radius ", r)
  file.path(
    NEG_SEARCH_ROOT,
    paste0("radius", r, "_negative_full"),
    exact_name
  )
}


